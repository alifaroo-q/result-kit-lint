{
  "name": "@zireal/oxlint-plugin-result-kit",
  "version": "0.0.0",
  "description": "Oxlint (syntax-tier) port of must-use-result — a re-export of the shared rule-core rule.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "keywords": ["oxlint", "oxlint-plugin", "result-kit", "must-use-result"],
  "license": "MIT",
  "author": "Ali Farooq",
  "homepage": "https://github.com/alifaroo-q/result-kit-lint/tree/main/packages/oxlint-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alifaroo-q/result-kit-lint.git",
    "directory": "packages/oxlint-plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "oxlint": ">=1.0.0"
  },
  "devDependencies": {
    "@zireal/result-kit-rule-core": "workspace:*",
    "@typescript-eslint/parser": "^8.65.0"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  }
}
